{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/resume/download",
      "dest": "backend/main.py"
    },
    {
      "src": "/(api|health|chatbot|stream_chat|match_jd)(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/(.+\\.(pdf|css|js|png|jpg|jpeg|svg|ico|woff|woff2|ttf|otf|webp|gif))",
      "dest": "frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/main.py"
    }
  ],
  "env": {
    "GROQ_API_KEY": "@groq_api_key"
  }
}
